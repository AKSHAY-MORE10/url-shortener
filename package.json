    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.3.0",
    "@types/supertest": "^7.2.1",
    "autocannon": "^8.0.0",
    "dotenv-cli": "^11.0.0",
